deployment.yaml------
apiVersion: apps/v1
kind: Deployment
metadata:
  name: react-app
spec:
  replicas: 2
  selector:
    matchLabels:
      app: react-app
  template:
    metadata:
      labels:
        app: react-app
    spec:
      containers:
      - name: react-app
        image: YOUR_DOCKER_USERNAME/react-demo:1
        ports:
        - containerPort: 3000

Service.yml------
apiVersion: v1
kind: Service
metadata:
  name: react-service
spec:
  type: NodePort
  selector:
    app: react-app
  ports:
  - port: 3000
    targetPort: 3000
    nodePort: 30080

kubectl apply -f deployment.yaml
kubectl apply -f service.yaml

check:
kubectl get pods
kubectl get deployments
kubectl get services

open:
minikube service react-service

STEP 15 Create Jenkinsfile
pipeline {
    agent any
    environment {
        IMAGE="sunnymca107/react-demo:${BUILD_NUMBER}"
    }
    stages {
        stage('Clone') {
            steps {
                git 'https://github.com/sunnymca107/react-demo.git'
            }
        }
        stage('Install') {
            steps {
                sh 'npm install'
            }
        }
        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }
        stage('Docker Build') {
            steps {
                sh 'docker build -t $IMAGE .'
            }
        }
        stage('Docker Push') {
            steps {
                sh 'docker push $IMAGE'
            }
        }
        stage('Deploy Kubernetes') {
            steps {
                sh 'kubectl apply -f deployment.yaml'
                sh 'kubectl apply -f service.yaml'
            }
        }
    }
}
    
