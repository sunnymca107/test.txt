
pipeline {

    agent any

    tools {
        nodejs 'NodeJS'
    }

    triggers {
        cron('H/2 * * * *')
    }

    stages {

        stage('Clone Repository') {
            steps {
                git branch: 'main',
                url: 'https://github.com/sunnymca107/react-demo.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build React App') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t react-demo .'
            }
        }

        stage('Deploy Docker Container') {
            steps {
                sh 'docker rm -f react-container || true'
                sh 'docker run -d -p 3000:3000 --name react-container react-demo'
            }
        }
    }
}
