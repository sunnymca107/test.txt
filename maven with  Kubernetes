deployment.yaml----
apiVersion: apps/v1
kind: Deployment
metadata:
  name: java-app
spec:
  replicas: 2
  selector:
    matchLabels:
      app: java-app
  template:
    metadata:
      labels:
        app: java-app
    spec:
      containers:
      - name: java-app
        image: sunnymca107/java-app:1
        ports:
        - containerPort: 8080

service.yaml---
apiVersion: v1
kind: Service
metadata:
  name: java-service
spec:
  type: NodePort
  selector:
    app: java-app
  ports:
  - port: 8080
    targetPort: 8080
    nodePort: 30081
kubectl apply -f deployment.yaml
kubectl apply -f service.yaml
